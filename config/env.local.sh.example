# Copy to env.local.sh or run: bash scripts/setup.sh
# Paths are absolute. Sourced by other toolkit scripts.

export WS_GIT_REPO_ROOT="/path/to/your/git/repository"
export WS_GIT_WORKTREE_PATH="/path/to/your/worktree/directory"

# Optional: if package folders are not direct children of the repo root (Recruitment, BusinessCentral, …),
# set the directory that contains those package folders:
# export WS_SF_PROJECTS_ROOT="/path/to/your/repo/packages"

# Optional: explicitly force/disable Salesforce-package prompts & the create-worktree package
# picker. Overrides the default heuristic (repo basename contains "Salesforce").
# export WS_SF_MODE=1     # force on
# export WS_SF_MODE=0     # force off

# Optional: space-separated list of Salesforce package names offered by the package picker
# (create-worktree.sh) and used by lib/sf-goto-package.sh. Defaults to:
#   Recruitment BusinessCentral Workforce Maia
# export WS_SF_PACKAGES="Recruitment BusinessCentral Workforce Maia"

# Optional: scripts/lib/ws-open-terminal.sh (for custom tools) — not used when selecting a project in ws-ui.
# export WS_OPEN_TERMINAL_HOOK="/path/to/your/open-terminal.sh"
# export WS_WT_WINDOW_ID=-1
